#!/bin/sh
# ⚠️ THE ONE COMMAND A NEW OPERATOR HAS TO RUN, so it is a command and not a
# paragraph in a README. It prompts, hashes with the host's own KDF, and writes
# the env file the unit reads - the password itself is never stored, never
# echoed, and never passed as an argument where `ps` could show it.
set -e
[ "$(id -u)" = "0" ] || { echo "run this with sudo" >&2; exit 1; }

LINE="$(/opt/hamdeck-cpp/hamdeck-host --hash-password)" || exit 1
install -d -m 0755 /etc/hamdeck-cpp
umask 077
printf '%s\n' "$LINE" > /etc/hamdeck-cpp/env
chmod 0640 /etc/hamdeck-cpp/env
echo "written to /etc/hamdeck-cpp/env"
echo "  sudo systemctl restart hamdeck-cpp"
